{
  "expo": {
    "name": "Budget Buddy",
    "slug": "budget-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-green.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "budget-buddy",
    "splash": {
      "image": "./assets/splash-icon-green.png",
      "resizeMode": "contain",
      "backgroundColor": "#050705"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.budgetbuddy.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-green.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.budgetbuddy.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon-green.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
