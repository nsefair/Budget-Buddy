{
  "expo": {
    "name": "Budget Buddy",
    "slug": "budget-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-green.png",
    "userInterfaceStyle": "automatic",
    "scheme": "budget-buddy",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.budgetbuddy.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-green.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.budgetbuddy.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon-green.png"
    },
    "plugins": [
      "./plugins/with-personal-team-ios",
      "./plugins/with-minimum-ios-pod-target",
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Budget Buddy uses only the photos you choose when you share a win with your Buds."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-green.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#050705"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
