APP_ENV=development
HTTP_ADDR=:8080
API_BASE_PATH=/v1
LOG_LEVEL=debug
RATE_LIMIT_PER_MINUTE=240

DATABASE_URL=postgres://budget_buddy:budget_buddy@localhost:5433/budget_buddy?sslmode=disable
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

JWT_ACCESS_SECRET=replace_with_long_random_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AUTH_ACTION_TOKEN_TTL=1h

APP_PUBLIC_URL=budget-buddy://
EMAIL_DELIVERY_MODE=log
EMAIL_FROM=Budget Buddy <no-reply@budgetbuddy.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

BILLING_ENV=sandbox
BILLING_WEBHOOK_SECRET=replace_with_long_random_secret
IOS_PREMIUM_MONTHLY_PRODUCT_ID=budget_buddy_premium_monthly
IOS_PREMIUM_ANNUAL_PRODUCT_ID=budget_buddy_premium_annual
IOS_ELITE_MONTHLY_PRODUCT_ID=budget_buddy_elite_monthly
IOS_ELITE_ANNUAL_PRODUCT_ID=budget_buddy_elite_annual

PLAID_CLIENT_ID=replace_me
PLAID_SECRET=replace_me
PLAID_ENV=sandbox
OPENAI_API_KEY=replace_me
