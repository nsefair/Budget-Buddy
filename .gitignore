# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.cursor/
__pycache__/
*.pyc

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
coverage/
.nyc_output/
security-audit*.json
gitleaks*.json

# macOS
.DS_Store
*.pem

# local env files (never commit real keys)
.env
.env.*
!.env.example
!backend/.env.example
.env*.local

# local reports and temporary files
*.tmp
*.temp
*.bak
*.swp
.cache/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
